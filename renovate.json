{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": ["after 2am and before 3am on sunday"],
  "rangeStrategy": "replace",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["after 2am and before 3am on sunday"],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Automerge low-risk npm patch and minor updates after required CI passes",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep npm major updates manually approved",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "description": "Keep GitHub Actions updates visible and manually approved",
      "matchManagers": ["github-actions"],
      "automerge": true
    }
  ]
}
