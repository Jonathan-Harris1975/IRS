{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "*": "allow",
    "edit": {
      "*": "allow",
      "kilo.jsonc": "deny",
      ".github/workflows/*": "deny",
      ".github/actions/*": "deny",
      ".github/scripts/*": "deny",
      ".github/CODEOWNERS": "deny",
      ".github/dependabot.yml": "deny",
      ".mergify.yml": "deny",
      "renovate.json": "deny",
      "SECURITY.md": "deny",
      "AUTONOMY.md": "deny",
      "CI_SETUP.txt": "deny"
    },
    "write": {
      "*": "allow",
      "kilo.jsonc": "deny",
      ".github/workflows/*": "deny",
      ".github/actions/*": "deny",
      ".github/scripts/*": "deny",
      ".github/CODEOWNERS": "deny",
      ".github/dependabot.yml": "deny",
      ".mergify.yml": "deny",
      "renovate.json": "deny",
      "SECURITY.md": "deny",
      "AUTONOMY.md": "deny",
      "CI_SETUP.txt": "deny"
    },
    "apply_patch": {
      "*": "allow",
      "kilo.jsonc": "deny",
      ".github/workflows/*": "deny",
      ".github/actions/*": "deny",
      ".github/scripts/*": "deny",
      ".github/CODEOWNERS": "deny",
      ".github/dependabot.yml": "deny",
      ".mergify.yml": "deny",
      "renovate.json": "deny",
      "SECURITY.md": "deny",
      "AUTONOMY.md": "deny",
      "CI_SETUP.txt": "deny"
    },
    "external_directory": "deny",
    "question": "deny",
    "bash": {
      "*": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git fetch *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git merge origin/main": "allow",
      "git merge --no-edit origin/main": "allow",
      "git merge --abort": "allow",
      "git push origin HEAD": "allow",
      "git push --set-upstream origin HEAD": "allow",
      "git push -u origin HEAD": "allow",
      "npm ci *": "allow",
      "npm test *": "allow",
      "npm run check *": "allow",
      "npm run audit:targets *": "allow",
      "npm run scan:secrets *": "allow",
      "npm run verify *": "allow",
      "npm run verify:release *": "allow",
      "npm run lint *": "allow",
      "node --test *": "allow",
      "git checkout main": "deny",
      "git switch main": "deny",
      "git push *:*": "deny",
      "git push +*": "deny",
      "git push --force": "deny",
      "git push -f": "deny",
      "git push --force-with-lease": "deny",
      "git push --mirror": "deny",
      "git push --delete": "deny",
      "git push *--force*": "deny",
      "git push * -f*": "deny",
      "bash -c *": "deny",
      "sh -c *": "deny",
      "gh pr merge *": "deny",
      "wrangler deploy *": "deny",
      "npx wrangler deploy *": "deny"
    }
  }
}
